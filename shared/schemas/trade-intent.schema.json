{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongOnlyTradeIntent",
  "type": "object",
  "required": ["intent_id", "lab_id", "originator", "created_at", "data_cutoff", "ticker", "side", "action", "thesis", "horizon_days", "confidence"],
  "properties": {
    "intent_id": {"type": "string"},
    "lab_id": {"type": "string"},
    "originator": {"type": "string"},
    "strategy_version": {"type": "string"},
    "code_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "ticker": {"type": "string"},
    "side": {"enum": ["buy", "sell", "hold", "no_trade"]},
    "action": {"enum": ["buy", "trim", "close", "hold", "no_trade"]},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "target_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "horizon_days": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "expected_gross_edge_bps": {"type": ["number", "null"]},
    "expected_net_edge_bps": {"type": ["number", "null"]},
    "thesis": {"type": "string"},
    "invalidators": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"side": {"const": "sell"}}}, "then": {"properties": {"action": {"enum": ["trim", "close"]}}}},
    {"if": {"properties": {"side": {"const": "buy"}}}, "then": {"properties": {"action": {"const": "buy"}}}}
  ]
}
